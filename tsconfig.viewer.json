{
  // The browser half. It shares `types.ts` with the Node code but must never pull in Node types,
  // and it has to come out as a plain script: the HTML inlines it in a classic <script> tag, so
  // the emitted file may not contain a single import or export statement. `import type` is erased,
  // which is why the viewer may only ever import types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/viewer/viewer.ts"]
}
